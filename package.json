{
  "name": "liquid-glass-react",
  "version": "1.1.1",
  "description": "Apple's Liquid Glass effect for React",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "bash test-apps/setup.sh && bash test-apps/run.sh && bash test-apps/package-check.sh"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "component",
    "library",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoniojmiranda82-cyberdev/liquid-glass-react.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./premium": {
      "import": {
        "types": "./dist/premium.d.mts",
        "default": "./dist/premium.mjs"
      },
      "require": {
        "types": "./dist/premium.d.ts",
        "default": "./dist/premium.js"
      }
    }
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "premium": [
        "dist/premium.d.ts"
      ]
    }
  }
}
